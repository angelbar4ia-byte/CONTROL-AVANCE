      }
    },
    "/api/v1/cierres": {
      "get": {
        "tags": [
          "cierres"
        ],
        "summary": "Bandeja de cierres por rol",
        "description": "Bandeja de solicitudes visibles para el rol actual.\n\nEs una lectura simple sin orquestación de dominio —como `GET /me`\n(`adapters/api/v1/identidad.py`)— así que consulta el repo directo, sin\ncaso de uso: RLS ya acota el alcance (§12.4).",
        "operationId": "listar_cierres_api_v1_cierres_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "estatus",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/EstatusSolicitudCierre"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtra por estatus del flujo (§7.8).",
              "title": "Estatus"
            },
            "description": "Filtra por estatus del flujo (§7.8)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CierreRespuesta"
                  },
                  "title": "Response Listar Cierres Api V1 Cierres Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/obras/{obra_id}/estimaciones": {
