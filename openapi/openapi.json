{
  "openapi": "3.1.0",
  "info": {
    "title": "ObraCtrl API",
    "description": "Control de avance de obra para vivienda en serie. REST + OpenAPI; los hooks de TanStack Query se autogeneran con Orval desde este esquema (§12.2).",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "tags": [
          "identidad"
        ],
        "summary": "Perfil y alcance",
        "description": "Devuelve el perfil del token y su alcance efectivo.\n\nEl conteo de obras sale de una consulta normal: RLS ya filtra por rol, así\nque el número es el alcance real y no hay que calcularlo en la API (§12.4).",
        "operationId": "obtener_perfil_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerfilRespuesta"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/actividades/{actividad_id}/avance": {
      "patch": {
        "tags": [
          "avance"
        ],
        "summary": "Capturar avance de una actividad",
        "description": "Captura el avance ejecutado de una actividad (§11.3 B).\n\nLa ruta web y la conciliación offline del móvil pasan por el mismo caso de\nuso, para que ambas apliquen exactamente las mismas reglas.",
        "operationId": "capturar_avance_api_v1_actividades__actividad_id__avance_patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "actividad_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Actividad Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapturaAvancePeticion"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvanceRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "La actividad no existe o está fuera de tu alcance."
          },
          "409": {
            "description": "Actividad bloqueada por una incidencia que detiene."
          },
          "422": {
            "description": "Violación de una regla de captura (§6)."
          }
        }
      }
    },
    "/api/v1/actividades/{actividad_id}/cierre": {
      "post": {
        "tags": [
          "cierres"
        ],
        "summary": "Solicitar el cierre de una actividad",
        "description": "El Residente solicita el cierre de una actividad (§11.3 C.1).",
        "operationId": "solicitar_cierre_api_v1_actividades__actividad_id__cierre_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "actividad_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Actividad Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitarCierrePeticion"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CierreRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "La actividad no existe o está fuera de tu alcance."
          },
          "422": {
            "description": "Falta checklist o evidencias (§6)."
          }
        }
      }
    },
