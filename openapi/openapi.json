        "summary": "Generar la estimación de la semana activa",
        "description": "Residente o Supervisor generan la estimación (§11.3 E.1-2).",
        "operationId": "generar_estimacion_api_v1_obras__obra_id__estimaciones_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "obra_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Obra Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
