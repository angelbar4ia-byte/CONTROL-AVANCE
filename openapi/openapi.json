  "components": {
    "schemas": {
      "AvanceRespuesta": {
        "properties": {
          "actividad_id": {
            "type": "string",
            "format": "uuid",
            "title": "Actividad Id"
          },
          "cant_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cant Base"
          },
          "cant_programada": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cant Programada"
          },
          "cant_ejecutada": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cant Ejecutada"
          },
          "avance_pct": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Avance Pct"
          },
          "estatus": {
            "type": "string",
            "title": "Estatus"
          }
        },
        "type": "object",
        "required": [
          "actividad_id",
          "cant_base",
          "cant_programada",
          "cant_ejecutada",
          "avance_pct",
          "estatus"
        ],
        "title": "AvanceRespuesta"
      },
      "CapturaAvancePeticion": {
        "properties": {
          "cant_ejecutada": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Cant Ejecutada",
            "description": "No puede exceder la programada."
          },
          "cant_programada": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cant Programada",
            "description": "Si se envía, se revalida contra cant_base × 1.2."
          },
          "fecha": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fecha",
            "description": "Fecha de la captura. Por defecto, hoy."
          },
          "evidencias": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidencias",
            "description": "URLs ya subidas a R2 vía presigned URL (§11.2)."
          }
        },
        "type": "object",
        "required": [
          "cant_ejecutada"
        ],
        "title": "CapturaAvancePeticion",
        "description": "Captura de avance (§6).\n\nLas mismas reglas se reflejan en el cliente para UX y se aplican de forma\nautoritativa en el servidor (§11.1)."
      },
      "CierreRespuesta": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "actividad_id": {
            "type": "string",
            "format": "uuid",
            "title": "Actividad Id"
          },
          "solicitada_por": {
            "type": "string",
            "format": "uuid",
            "title": "Solicitada Por"
          },
          "autorizada_por": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Autorizada Por"
          },
          "validada_por": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validada Por"
          },
          "cantidad": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cantidad"
          },
          "monto": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Monto"
          },
          "checklist": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Checklist"
          },
          "adjuntos": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Adjuntos"
          },
          "comentarios": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comentarios"
          },
          "estatus": {
            "type": "string",
            "title": "Estatus"
          }
        },
        "type": "object",
        "required": [
          "id",
          "actividad_id",
          "solicitada_por",
          "autorizada_por",
          "validada_por",
          "cantidad",
          "monto",
          "checklist",
          "adjuntos",
          "comentarios",
          "estatus"
        ],
        "title": "CierreRespuesta"
      },
      "EstatusSolicitudCierre": {
        "type": "string",
        "enum": [
          "solicitada",
          "autorizada",
          "validada",
          "rechazada"
        ],
        "title": "EstatusSolicitudCierre"
      },
      "EstimacionRespuesta": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "obra_id": {
            "type": "string",
            "format": "uuid",
            "title": "Obra Id"
          },
          "folio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Folio"
          },
          "semana": {
            "type": "integer",
            "title": "Semana"
          },
          "anio": {
            "type": "integer",
            "title": "Anio"
          },
          "modo": {
            "type": "string",
            "title": "Modo"
          },
          "estatus": {
            "type": "string",
            "title": "Estatus"
          },
          "monto_total": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Monto Total"
          },
          "origen_erp": {
            "type": "boolean",
            "title": "Origen Erp"
          },
          "creada_por": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Creada Por"
          },
