# ObraCtrl web — variables de Vercel por entorno (§12.8)
# Vite solo expone al cliente las que empiezan con VITE_.

# Ruta directa de catálogos (§10.7).
# SOLO la anon key. La service key nunca llega al navegador: saltaría RLS.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# API FastAPI en Render (§12.8). En dev, vite.config.ts la proxea.
VITE_API_URL=http://localhost:8000

VITE_SENTRY_DSN=
