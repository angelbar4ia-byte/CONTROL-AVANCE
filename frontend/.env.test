# Variables dummy para vitest (modo "test" de Vite carga este archivo).
#
# `src/lib/supabase.ts` lanza si faltan estas variables, y varios módulos
# (api/cliente.ts, los hooks generados, app/sesion.ts) lo importan de forma
# transitiva. Sin este archivo, cualquier prueba que toque esa cadena de
# imports falla en tiempo de carga del módulo, no por la lógica probada.
#
# Valores ficticios: no apuntan a un proyecto real de Supabase.
VITE_SUPABASE_URL=https://obractrl-test.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key-not-a-real-secret
VITE_API_URL=http://localhost:8000
