# ObraCtrl API — variables por entorno (§12.8)
# Copiar a .env para desarrollo local. NUNCA commitear el .env real.

ENTORNO=dev
DEBUG=true

# Postgres/Supabase. Usa el rol obractrl_api: NO debe ser dueño de las tablas,
# porque el owner salta RLS (§12.4).
DATABASE_URL=postgresql+asyncpg://obractrl_api:...@localhost:5432/obractrl

# JWT del proveedor administrado; de aquí salen org_id y rol (§12.4)
JWT_SECRET=cambiar-en-produccion
JWT_ALGORITMO=HS256
JWT_AUDIENCIA=authenticated

# Ruta directa de catálogos desde el front (§10.7).
# Solo la ANON KEY. La service key nunca sale del backend ni entra aquí.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Jobs
REDIS_URL=redis://localhost:6379/0

# Evidencias (Cloudflare R2)
R2_ENDPOINT=
R2_BUCKET=obractrl-evidencias
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Origen de Vercel permitido por CORS (§12.8). Separar con comas.
CORS_ORIGENES=http://localhost:5173

SENTRY_DSN=
