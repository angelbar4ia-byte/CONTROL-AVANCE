{
  "expo": {
    "name": "ObraCtrl",
    "slug": "obractrl",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "obractrl",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFCFD"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ObraCtrl usa la cámara para adjuntar evidencias fotográficas de avances, incidencias y revisiones en obra."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ObraCtrl accede a tus fotos para adjuntar evidencias a los avances e incidencias de obra."
        }
      ]
    ],
    "android": {
      "package": "com.obractrl.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBFCFD"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.obractrl.app"
    },
    "extra": {
      "router": {},
      "eas": { "projectId": "00000000-0000-0000-0000-000000000000" }
    },
    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000"
    },
    "runtimeVersion": { "policy": "appVersion" }
  }
}
